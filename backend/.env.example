# ==============================================================================
# Django Pet Adoption Platform - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with your environment-specific credentials.
# Do NOT commit your actual '.env' file to source control.

# ------------------------------------------------------------------------------
# Django Core Settings
# ------------------------------------------------------------------------------
# Secret key for cryptographic signing (generate a secure random 50+ char string in production)
SECRET_KEY=django-insecure-replace-this-with-a-secure-random-key

# Set to True for local development, False in production
DEBUG=True

# Comma-separated list of allowed hostnames/IPs
ALLOWED_HOSTS=localhost,127.0.0.1,*

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
DB_NAME=pet_adoption
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password
DB_HOST=127.0.0.1
DB_PORT=5432

# ------------------------------------------------------------------------------
# Razorpay Payment Gateway Credentials
# ------------------------------------------------------------------------------
# Obtain from your Razorpay Dashboard (API Keys & Webhooks)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ------------------------------------------------------------------------------
# Email Backend Configuration
# ------------------------------------------------------------------------------
# Use console backend for development, SMTP backend in production
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# ------------------------------------------------------------------------------
# Media & Cloudinary CDN Storage Configuration
# ------------------------------------------------------------------------------
# Set USE_CLOUDINARY=False for local filesystem storage (MEDIA_ROOT), True in production/staging
USE_CLOUDINARY=False
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# CORS & CSRF Configuration
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Delivery OTP Verification Security Configuration
# ------------------------------------------------------------------------------
OTP_TTL_MINUTES=1440
OTP_MAX_ATTEMPTS=3
OTP_THROTTLE_RATE=10/min
